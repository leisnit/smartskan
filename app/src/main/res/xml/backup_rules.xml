<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Keep in step with data_extraction_rules.xml. These versions have no
     separate rule for phone-to-phone transfer, so the same exclusions apply to both. -->
<full-backup-content>
    <exclude domain="file" path="documents/" />
    <exclude domain="file" path="thumbnails/" />
    <exclude domain="file" path="documents.json" />
    <exclude domain="file" path="codes.json" />
    <exclude domain="file" path="expenses.json" />
    <exclude domain="file" path="signature.json" />
</full-backup-content>
