<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above. ID scans, signatures and spending records stay out of Google's cloud
     backup. A direct phone-to-phone transfer, which the user starts, still copies everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="documents/" />
        <exclude domain="file" path="thumbnails/" />
        <exclude domain="file" path="documents.json" />
        <exclude domain="file" path="codes.json" />
        <exclude domain="file" path="expenses.json" />
        <exclude domain="file" path="signature.json" />
    </cloud-backup>
</data-extraction-rules>
